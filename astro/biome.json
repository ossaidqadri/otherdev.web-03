{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
	"files": {
		"includes": ["src/**", "scripts/**", "*.mjs", "*.ts", "!**/*.astro", "!**/*.svelte", "!src/lib/components/ui", "!src/lib/utils.ts", "!src/styles/tokens.css", "!src/styles/theme.css", "!src/content"]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } }
}


