---
import { getCollection, render } from "astro:content";
import CtaScene from "@/components/CtaScene.astro";
import PillNav from "@/components/PillNav.astro";
import WorkCard from "@/components/WorkCard.astro";
import { Badge } from "@/lib/components/ui/badge";
import { Button } from "@/lib/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { getPage, getSite } from "@/lib/site";

export async function getStaticPaths() {
  const all = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    // Next three projects, wrapping, so every page links onward.
    props: { entry, related: [1, 2, 3].map((n) => all[(i + n) % all.length]!) },
  }));
}

const { entry, related } = Astro.props;
const { ui, closing } = await getSite();
const { work } = await getPage("home");
const { title, year, tags, link, downloadUrl, excerpt, cover, gallery } = entry.data;
const { Content } = await render(entry);
const href = link && (link.startsWith("http") ? link : `https://${link}`);
// First sentence leads the intro; the full write-up opens on "Read more", as on the reference.
const lead = (excerpt ?? "").replace(/\.\.\.$/, "").split(/(?<=\.)\s/)[0] ?? "";

// Gallery rhythm from the reference: one 16:9 tile, then a pair of 4:5 tiles, repeating. The cover
// opens it; gallery shots that repeat the cover are dropped.
const media = [cover, ...gallery.filter((g) => g.src !== cover.src)];
const rows: (typeof media)[] = [];
for (let i = 0; i < media.length; ) {
  const pair = rows.length % 2 === 1;
  rows.push(media.slice(i, i + (pair ? 2 : 1)));
  i += pair ? 2 : 1;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: excerpt,
  image: cover.src,
  dateCreated: String(year),
  ...(href ? { url: href } : {}),
};
const rule = "w-full border-0 border-t border-[var(--semantic-transparent-core)]";
---

<Layout title={`${title} | otherdev`} description={excerpt ?? title} image={cover.src} imageAlt={cover.alt} type="article" jsonLd={jsonLd}>
  <main id="main">
    <section id="overview" class="case-hero pt-[var(--container-navpadding)] pb-[var(--section-padding-lg)]" data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-md)] pt-[var(--section-padding-sm)]">
        <div class="type-mega-button max-w-[64rem] pt-16">
          <h1>{title}</h1>
        </div>
        <div class="flex w-full flex-col md:flex-row" data-read-more>
          <div class="flex flex-1 flex-col items-start gap-8 md:sticky md:top-[var(--container-navpadding)] md:self-start md:pr-[var(--card-padding)]">
            {tags.length > 0 && (
              <div class="flex flex-wrap items-center gap-1">
                {tags.map((t) => <Badge variant="tag" class="type-body-button-s">{t}</Badge>)}
              </div>
            )}
            <div class="type-heading-s flex max-w-[40rem] flex-col gap-1">
              <p>{lead}</p>
              <button type="button" aria-expanded="false" aria-controls="case-details" class="w-fit cursor-pointer text-left opacity-40 transition-opacity duration-300 hover:opacity-60 focus-visible:opacity-60" data-more={ui.readMore} data-less={ui.readLess}>{ui.readMore}</button>
            </div>
          </div>
          {/* Opens to the full write-up and the facts; height eases open like the reference's. */}
          <div id="case-details" class="details grid min-w-0 md:flex-1">
            <div class="min-h-0 overflow-hidden">
              <div class="flex w-full max-w-[40rem] flex-col gap-14 max-md:pt-[var(--section-padding-sm)]">
                <hr class={rule} />
                <div class="flex flex-col">
                  <div class="prose-site type-article-body flex flex-col gap-6 pb-12 opacity-80"><Content /></div>
                  <dl class="flex w-full flex-col gap-6">
                    <div class="flex w-full items-start gap-1">
                      <dt class="type-body-button-s flex-1 py-1.5 opacity-40">{ui.year}</dt>
                      <dd class="flex flex-1 flex-wrap gap-1.5"><Badge variant="tag" class="type-body-button-s">{year}</Badge></dd>
                    </div>
                    {tags.length > 0 && (
                      <>
                        <hr class={rule} />
                        <div class="flex w-full items-start gap-1">
                          <dt class="type-body-button-s flex-1 py-1.5 opacity-40">{ui.discipline}</dt>
                          <dd class="flex flex-1 flex-wrap gap-1.5">{tags.map((t) => <Badge variant="tag" class="type-body-button-s">{t}</Badge>)}</dd>
                        </div>
                      </>
                    )}
                    {(href || downloadUrl) && (
                      <>
                        <hr class={rule} />
                        <div class="flex w-full items-start gap-1">
                          <dt class="type-body-button-s flex-1 py-1.5 opacity-40">{ui.website}</dt>
                          <dd class="flex flex-1 flex-wrap gap-1.5">
                            {href && <Badge href={href} rel="noopener noreferrer" target="_blank" variant="tag" class="type-body-button-s">{link}</Badge>}
                            {downloadUrl && <Badge href={downloadUrl} variant="tag" class="type-body-button-s">{ui.download}</Badge>}
                          </dd>
                        </div>
                      </>
                    )}
                  </dl>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="the-work" class="pb-[var(--section-padding-lg)]" data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-4">
        {rows.map((row) => (
          <div class:list={["grid gap-4", row.length > 1 && "md:grid-cols-2"]}>
            {row.map((m) => (
              <div class:list={["relative w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--semantic-fill-secondary)]", row.length > 1 ? "aspect-[4/5]" : "aspect-video"]}>
                <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" class="absolute inset-0 size-full scale-[1.01] object-cover object-top" />
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section id="more-work" class="pb-[var(--section-padding-lg)]" data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-sm)]">
        <div class="flex w-full flex-col items-start gap-2 md:flex-row md:items-end md:gap-8">
          <div class="flex-1"><h2 class="type-heading-l max-w-[64rem]">{ui.relatedWork}</h2></div>
          <Button href={work.all.href} variant="nav" size="nav" class="type-heading-l -ml-2.5 rounded-lg md:ml-0">
            <span class="inline-flex items-center gap-1 opacity-40">
              <span>{ui.seeAll}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 translate-y-[0.03em]" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </span>
          </Button>
        </div>
        <hr class={rule} />
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <li><WorkCard project={p} /></li>)}
        </ul>
        <hr class={rule} />
      </div>
    </section>

    <CtaScene heading={closing.heading} body={closing.body} button={closing.button} />
  </main>
  <PillNav items={[{ label: ui.overview, target: "overview" }, { label: ui.theWork, target: "the-work" }, { label: ui.moreWork, target: "more-work" }]} />
</Layout>

<style>
  /* Pale sky fading to white, as the reference's per-project hero (otherdev has no per-project colour yet). */
  .case-hero {
    background: linear-gradient(180deg, transparent 27%, rgb(247 249 252) 82%, #fff 100%), var(--global-winter-100);
  }
  .details {
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  [data-read-more][data-open] .details {
    grid-template-rows: 1fr;
    opacity: 1;
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-read-more] button[aria-expanded]");
    const root = btn?.closest<HTMLElement>("[data-read-more]");
    if (!btn || !root) return;
    const open = !root.hasAttribute("data-open");
    root.toggleAttribute("data-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? "";
  });
</script>
