---
import Words from "@/components/Words.astro";
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/lib/components/ui/button";
import { Checkbox } from "@/lib/components/ui/checkbox";
import { Input } from "@/lib/components/ui/input";
import { getPage, getSite } from "@/lib/site";
import { Separator } from "@/lib/components/ui/separator";

const n = await getPage("newsletter");
const { ui } = await getSite();
const STEP = 75;
// The reference's fields: 16px type, soft fill that darkens on hover, example text at 40%.
const field = "type-body-button-m h-auto w-full rounded-[var(--radius-sm)] bg-[var(--semantic-transparent-weak)] p-4 placeholder:opacity-40 hover:bg-[var(--semantic-transparent-core)] duration-200";
const label = "type-body-button-m flex items-start justify-between";
---

<Layout title="Newsletter | Other Dev" description={n.body}>
  <main id="main">
    {/* Headline and sub fade up word by word on load, as on the services hero. */}
    <section class="pt-[var(--container-navpadding)]" data-navbar-theme="dark">
      <div class="site-container py-[var(--section-padding-lg)]">
        <div class="flex max-w-[64rem] flex-col gap-y-[10px]" data-in>
          <Words as="h1" text={n.heading} step={STEP} class="gap-x-[0.45em] gap-y-[0.1em]" word="type-mega-button" />
          <Words text={n.body} step={STEP} start={n.heading.split(/\s+/).length} class="gap-x-[0.45em] gap-y-[0.1em] opacity-40" word="type-mega-button" />
        </div>
      </div>
    </section>

    <section data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-sm)] pb-[var(--section-padding-lg)]">
        <Separator decorative />
        {/* Disabled until a signup backend is chosen; the form then needs hydrating (Checkbox is a bits-ui button). */}
        <form class="w-full max-w-[40rem]" aria-describedby="newsletter-note">
          <fieldset disabled class="flex min-w-0 flex-col gap-8">
            <div class="grid gap-8 md:grid-cols-2 md:gap-4">
              <div class="flex flex-col gap-2">
                <label for="first" class={label}>{n.fields.firstName}</label>
                <Input variant="soft" id="first" name="first" class={field} placeholder={n.examples.firstName} autocomplete="given-name" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="last" class={label}>{n.fields.lastName}</label>
                <Input variant="soft" id="last" name="last" class={field} placeholder={n.examples.lastName} autocomplete="family-name" />
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class={label}>{n.fields.email}</label>
              <Input variant="soft" id="email" type="email" name="email" class={field} placeholder={n.examples.email} autocomplete="email" />
            </div>
            <fieldset class="flex w-full flex-col gap-2">
              <legend class="type-body-button-m mb-2">{n.interestsLabel}</legend>
              {n.interests.map((i, k) => (
                <label for={`interest-${k}`} class="flex w-full cursor-pointer items-start gap-3">
                  <Checkbox id={`interest-${k}`} name="interests" value={i} class="size-6 rounded-[var(--radius-sm)] border-0 bg-[var(--semantic-transparent-core)] data-checked:bg-[var(--global-contrast)]" />
                  <span class="type-body-regular-m min-h-6 flex-1 py-px">{i}</span>
                </label>
              ))}
            </fieldset>
            <p class="type-body-paragraph-xs max-w-lg opacity-60">{n.consent} <a href={n.privacy.href} class="underline-offset-2 hover:underline">{n.privacy.label}</a>.</p>
            <Button type="submit" variant="glass" size="pill" class="type-body-button-m w-fit [--pill-bg:var(--semantic-transparent-weak)] [--pill-fg:var(--semantic-text-primary)] disabled:opacity-60">{ui.submit}</Button>
          </fieldset>
          <p id="newsletter-note" class="type-body-regular-s mt-4 opacity-60">{n.note}</p>
        </form>
        <Separator decorative />
      </div>
    </section>
  </main>
</Layout>
