---
import Layout from "@/layouts/Layout.astro";
import { getPage } from "@/lib/site";

const page = await getPage("notFound");
---

<Layout title="Not found | Other Dev" description={page.heading} noindex>
  <main id="main" class="site-container section pt-40" data-navbar-theme="dark">
    <h1 class="type-display-s">{page.heading}</h1>
    <a href={page.link.href} class="type-heading-m text-ink-3 mt-8 inline-block">{page.link.label} →</a>
  </main>
</Layout>
