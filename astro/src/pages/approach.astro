---
import CtaScene from "@/components/CtaScene.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";

const { approach } = (await getEntry("site", "home"))!.data;
const featured = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
// First sentence of the excerpt; the stored excerpts are cut mid-sentence with "...".
const lead = (s = "") => s.replace(/\.\.\.$/, "").split(/(?<=\.)\s/)[0] ?? "";
---

<Layout title="Approach | otherdev" description={approach.heading}>
  <main>
    <section class="approach-hero" data-navbar-theme="light">
      <div class="site-container pt-48 pb-[var(--section-padding-lg)]">
        <h1 class="type-hero max-w-5xl text-white">{approach.heading}</h1>
      </div>
    </section>

    <section class="site-container section" data-navbar-theme="dark">
      <ol>
        {approach.steps.map((s, i) => (
          <li class="border-border grid gap-4 border-t py-12 last:border-b md:grid-cols-[1fr_2fr]">
            <h2 class="type-display-s">{s.title}</h2>
            <p class="type-heading-l text-ink-3 max-w-2xl">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="site-container section pt-0" data-navbar-theme="dark">
      <h2 class="type-heading-l">{approach.projectsHeading}</h2>
      <ul class="mt-12 grid gap-2 md:grid-cols-3">
        {featured.map((p) => (
          <li>
            <a href={`/work/${p.id}`} class="block">
              <img src={p.data.cover.src} alt={p.data.cover.alt} width={p.data.cover.width} height={p.data.cover.height} loading="lazy" class="aspect-[4/3] w-full rounded-lg object-cover object-top" />
              <h3 class="type-body-regular-l mt-4">{p.data.title}</h3>
              <p class="type-body-paragraph-m text-ink-3 mt-2">{lead(p.data.excerpt)}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CtaScene heading={approach.closing.heading} body={approach.closing.body} button={approach.closing.button} />
  </main>
</Layout>

<style>
  .approach-hero {
    background: linear-gradient(to bottom, #200a04 0%, #1a2342 45%, #355080 100%);
  }
</style>
