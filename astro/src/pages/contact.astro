---
import { Button } from "@/lib/components/ui/button";
import { getPage } from "@/lib/site";
import Layout from "@/layouts/Layout.astro";

const contact = await getPage("contact");
---

<Layout title="Contact | otherdev" description={contact.body}>
  <main id="main" class="site-container section pt-40" data-navbar-theme="dark">
    <h1 class="type-display-s max-w-5xl">{contact.heading}</h1>
    <p class="type-heading-l text-ink-3 mt-8 max-w-3xl">{contact.body}</p>
    <ul class="mt-12 flex flex-wrap gap-2">
      {contact.links.map((l) => (
        <li><Button href={l.href} rel="noopener noreferrer" target="_blank" variant="card" size="pill" class="type-body-button-m">{l.label}</Button></li>
      ))}
    </ul>
  </main>
</Layout>
