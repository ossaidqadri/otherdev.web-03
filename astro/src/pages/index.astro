---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Clients from "@/components/Clients.astro";
import WorkList from "@/components/WorkList.astro";
import Process from "@/components/Process.astro";
import News from "@/components/News.astro";
import Constellations from "@/components/Constellations.astro";
import PillNav from "@/components/PillNav.astro";
import { getSite } from "@/lib/site";

const { seo } = await getSite();
---

<Layout title="Other Dev | Digital Platforms For Pioneering Creatives" description={seo.home!}>
  <main id="main">
    <Hero />
    <Clients />
    <WorkList />
    <Process />
    <News />
    <Constellations />
  </main>
  <PillNav />
</Layout>
