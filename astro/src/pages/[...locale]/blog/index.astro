---
export { getStaticPaths } from "@/i18n/paths";
import { getCollection } from "astro:content";
import CtaScene from "@/components/CtaScene.astro";
import NewsletterCard from "@/components/NewsletterCard.astro";
import PostCard from "@/components/PostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { langOf } from "@/i18n/locales";
import { getPage, getSite } from "@/lib/site";
import { Separator } from "@/lib/components/ui/separator";

// /blog: headline, the newest post featured beside its cover, the rest as cards, then the
// newsletter and the shared closing. Layout, sizes and hovers follow the reference's news page.
const { hero } = await getPage("blog", Astro.currentLocale);
const { closing, ui, seo } = await getSite(Astro.currentLocale);
const date = new Intl.DateTimeFormat(langOf(Astro.currentLocale), { dateStyle: "medium" });
const [featured, ...rest] = (await getCollection("blog")).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---

<Layout page="blog" description={seo.blog!}>
  <main id="main">
    <section class="blog-hero pt-[var(--container-navpadding)]" data-navbar-theme="dark">
      <div class="site-container py-[var(--section-padding-lg)]">
        <div class="type-mega-button max-w-[64rem]">
          <h1>{hero.heading}</h1>
          <p class="opacity-40">{hero.sub}</p>
        </div>
      </div>

      {featured && (
        <div class="site-container flex flex-col gap-8 pb-[var(--section-padding-lg)]">
          <Separator />
          {/* Hover: the date shows and the excerpt slides up from below the title. */}
          <a href={`/blog/${featured.id}`} data-cursor-label={ui.readMore} class="group hidden w-full gap-4 md:flex md:flex-row md:items-stretch">
            <div class="flex flex-1 flex-col justify-between gap-[var(--section-padding-sm)] pe-16">
              <h2 class="type-heading-xl max-w-[40rem]">{featured.data.title}</h2>
              <div class="flex max-w-[40rem] flex-col items-start">
                <p class="type-body-paragraph-xs text-[var(--semantic-text-secondary)] opacity-0 transition-opacity duration-250 ease-out group-hover:opacity-100 group-focus-visible:opacity-100">{date.format(featured.data.publishedAt)}</p>
                {featured.data.excerpt && (
                  <div class="grid w-full grid-rows-[0fr] transition-[grid-template-rows] duration-250 ease-out group-hover:grid-rows-[1fr] group-focus-visible:grid-rows-[1fr]">
                    <div class="overflow-hidden">
                      <p class="type-heading-m translate-y-full pt-2 text-[var(--semantic-text-tertiary)] transition-[translate] duration-250 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0">{featured.data.excerpt}</p>
                    </div>
                  </div>
                )}
              </div>
            </div>
            <div class="w-[26.667rem] shrink-0">
              <div class="aspect-[4/5] w-full rounded-[var(--card-radius)] bg-[linear-gradient(160deg,var(--global-winter-300-dark),var(--global-autumn-50-dark))]"></div>
            </div>
          </a>
          <Separator class="hidden md:block" />
        </div>
      )}
    </section>

    {featured && (
      <section data-navbar-theme="dark">
        <div class="site-container py-[var(--section-padding-lg)]">
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {/* On phones the featured post is the first card, as on the reference. */}
            <li class="md:hidden"><PostCard href={`/blog/${featured.id}`} title={featured.data.title} excerpt={featured.data.excerpt} label={date.format(featured.data.publishedAt)} /></li>
            {rest.map((p) => (
              <li><PostCard href={`/blog/${p.id}`} title={p.data.title} excerpt={p.data.excerpt} label={date.format(p.data.publishedAt)} /></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section data-navbar-theme="dark">
      <div class="site-container pb-[var(--section-padding-lg)]">
        <NewsletterCard />
      </div>
    </section>

    <CtaScene heading={closing.heading} body={closing.body} button={closing.button} />
  </main>
</Layout>

<style>
  .blog-hero {
    background: linear-gradient(180deg, var(--global-spring-200) 0%, var(--global-winter-50) 55%, var(--global-spring-50) 85%, #fff 100%);
  }
</style>
