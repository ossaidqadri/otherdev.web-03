---
export { getStaticPaths } from "@/i18n/paths";
import { Image } from "astro:assets";
import ClientGrid from "@/components/ClientGrid.astro";
import CopyButton from "@/components/CopyButton.astro";
import CtaScene from "@/components/CtaScene.astro";
import Faq from "@/components/Faq.svelte";
import Testimonials from "@/components/Testimonials.astro";
import Words from "@/components/Words.astro";
import Layout from "@/layouts/Layout.astro";
import { getPage, getSite } from "@/lib/site";
import { Separator } from "@/lib/components/ui/separator";

const contact = await getPage("contact", Astro.currentLocale);
const { team } = await getPage("about", Astro.currentLocale);
const { clients } = await getPage("home", Astro.currentLocale);
const { footer, ui } = await getSite(Astro.currentLocale);
const STEP = 75;
// The reference's two panels: a 6% tint, 16px corners, 32px padding, the title 64px above the first row.
const card = "flex flex-1 flex-col gap-16 rounded-[var(--card-radius)] bg-[var(--semantic-transparent-weak)] p-[var(--card-padding)]";
// A person or inbox: name over a 60% line, the way to reach them at the bottom right.
const row = "flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4";
const text = "text-[var(--semantic-text-primary)]";
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: contact.faq.items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })),
};
---

<Layout page="contact" description={contact.body} jsonLd={faqLd}>
  <main id="main">
    {/* Headline and sub fade up word by word on load, as on the services hero. */}
    <section class="contact-hero pt-[var(--container-navpadding)]" data-navbar-theme="dark">
      <div class="site-container py-[var(--section-padding-lg)]">
        <div class="flex max-w-[64rem] flex-col gap-y-[10px]" data-in>
          <Words as="h1" text={contact.hero.heading} step={STEP} class="gap-x-[0.45em] gap-y-[0.1em]" word="type-mega-button" />
          <Words text={contact.hero.sub} step={STEP} start={contact.hero.heading.split(/\s+/).length} class="gap-x-[0.45em] gap-y-[0.1em] opacity-40" word="type-mega-button" />
        </div>
      </div>
    </section>

    <section data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-sm)] pt-[var(--section-padding-sm)] pb-[var(--section-padding-lg)]">
        {footer.offices.map((o) => (
          <>
            <Separator />
            {/* One office: a time-of-day disc, the city and its clock, copy buttons and the address on the left, a 4:3 photo on the right. */}
            <div class="grid gap-4 md:grid-cols-2">
              <div class="flex flex-col gap-16 py-7">
                <div aria-hidden="true" class="relative size-16 overflow-hidden rounded-full" style="background: linear-gradient(180deg, var(--global-summer-400) 0%, var(--global-summer-600) 22%, var(--global-summer-800) 71%, var(--global-autumn-900) 95%)">
                  <div data-sun class="absolute inset-0" style="background: linear-gradient(180deg, var(--global-summer-500) 0%, var(--global-summer-600) 15%, var(--global-summer-700) 35%, var(--global-autumn-900) 75%); opacity: 0.4"></div>
                </div>
                <div class="flex flex-col gap-8">
                  <div class="flex flex-col">
                    <h2 class={`type-heading-l ${text}`}>{o.city}</h2>
                    <time class={`type-heading-l block min-h-[1lh] opacity-40 ${text}`} data-clock={o.timezone}></time>
                  </div>
                  {/* Click copies, with a toast (Footer.astro); the reference's 24px lines. */}
                  <div class={`type-heading-m flex flex-col items-start gap-1 ${text}`}>
                    <CopyButton value={o.email} />
                    <CopyButton value={o.phone} />
                  </div>
                </div>
                {o.address.length > 0 && (
                  <a href={o.mapUrl} target="_blank" rel="noopener noreferrer" class={`type-heading-s mt-auto w-fit ${text}`}>
                    {o.address.map((line) => <span class="block">{line}</span>)}
                    <span class="sr-only">{ui.opensInNewTab}</span>
                  </a>
                )}
              </div>
              {o.photo && (
                <div class="relative aspect-[4/3] overflow-hidden rounded-[var(--card-radius)]">
                  <Image src={o.photo.src} alt={o.photo.alt} width={800} height={600} widths={[480, 640, 800, 1280]} sizes="(min-width: 768px) 50vw, 100vw" fit="cover" loading="lazy" class="absolute inset-0 size-full object-cover" />
                </div>
              )}
            </div>
          </>
        ))}
        <Separator />

        <div class="flex flex-col gap-4 md:flex-row">
          <div class={card}>
            <p class={`type-heading-m ${text}`}>{contact.foundersHeading}</p>
            <div class="flex flex-col gap-6">
              {team.map((m, i) => (
                <div class="flex flex-col gap-6">
                  {i > 0 && <Separator />}
                  <div class={row}>
                    <div class="flex items-center gap-4">
                      <div class="relative hidden size-[2.625rem] shrink-0 overflow-hidden rounded-full sm:block">
                        <Image src={m.photo.src} alt={m.name} width={96} height={96} fit="cover" position="top" loading="lazy" class="size-full object-cover" />
                      </div>
                      <div class="flex flex-col text-base leading-[1.3] font-[450] tracking-[-0.01rem]">
                        <p class={text}>{m.name}</p>
                        <p class={`opacity-60 ${text}`}>{m.role}</p>
                      </div>
                    </div>
                    {m.email && <CopyButton value={m.email} class={`type-body-button-m ${text}`} />}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class={card}>
            <p class={`type-heading-m ${text}`}>{contact.generalHeading}</p>
            <div class="flex flex-col gap-6">
              {contact.general.map((g, i) => (
                <div class="flex flex-col gap-6">
                  {i > 0 && <Separator />}
                  <div class={row}>
                    <div class="flex flex-col text-base leading-[1.3] font-[450] tracking-[-0.01rem]">
                      <p class={text}>{g.title}</p>
                      {g.note && <p class={`opacity-60 ${text}`}>{g.note}</p>}
                    </div>
                    {g.copy && <CopyButton value={g.copy} class={`type-body-button-m ${text}`} />}
                    {g.link && (
                      <a href={g.link.href} target="_blank" rel="noopener noreferrer" class={`type-body-button-m ${text}`}>
                        {g.link.label}<span class="sr-only">{ui.opensInNewTab}</span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-md)] py-[var(--section-padding-lg)]">
        <h2 class="type-heading-l max-w-[64rem]">{clients.heading}</h2>
        <div class="flex flex-col gap-2">
          <ClientGrid cells={6} />
          <Testimonials items={contact.testimonials} />
        </div>
      </div>
    </section>

    {/* Each answer opens in place: the row's dot grows in and the panel's height eases open, as on the reference. */}
    <section data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-sm)] py-[var(--section-padding-lg)]">
        <div class="flex w-full flex-col items-start gap-2 md:flex-row md:items-end md:gap-8">
          <div class="flex-1">
            <h2 class={`type-heading-l max-w-[64rem] ${text}`}>{contact.faq.heading}</h2>
            <p class={`type-heading-l max-w-[64rem] opacity-40 ${text}`}>{contact.faq.sub}</p>
          </div>
        </div>
        <Faq client:visible items={contact.faq.items} />
      </div>
    </section>

    <CtaScene heading={contact.closing.heading} body={contact.closing.body} button={contact.closing.button} />
  </main>
</Layout>

<style>
  /* The reference's warm hero: amber into cream and out to white. */
  .contact-hero {
    background: linear-gradient(var(--global-summer-400) 0%, var(--global-summer-300) 50%, var(--global-summer-100) 80%, var(--global-summer-50) 95%, #fff 100%);
  }
</style>

<script>
  // The disc beside each office is a gradient whose dusk layer takes a random strength on each load, as on the reference.
  for (const el of document.querySelectorAll<HTMLElement>("[data-sun]")) el.style.opacity = String(Math.random());
</script>
