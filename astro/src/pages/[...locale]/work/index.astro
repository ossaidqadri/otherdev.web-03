---
export { getStaticPaths } from "@/i18n/paths";
import WorkIndex from "@/components/WorkIndex.astro";
import Layout from "@/layouts/Layout.astro";
import { getPage, getSite } from "@/lib/site";

const { hero } = await getPage("work", Astro.currentLocale);
const { seo } = await getSite(Astro.currentLocale);
---

<Layout page="work" description={seo.work!}>
  <main id="main">
    {/* Top padding is the nav's plus a section's, as on the reference (headline at 256px on desktop). */}
    <section class="work-hero pt-[var(--container-navpadding)]" data-navbar-theme="dark">
      <div class="site-container py-[var(--section-padding-lg)]">
        <div class="type-mega-button max-w-[64rem]">
          <h1>{hero.heading}</h1>
          <p class="opacity-40">{hero.sub}</p>
        </div>
      </div>
    </section>
    <WorkIndex />
  </main>
</Layout>

<style>
  .work-hero {
    background: linear-gradient(var(--global-winter-300) 0%, var(--global-spring-50) 90%, #fff 100%);
  }
</style>
