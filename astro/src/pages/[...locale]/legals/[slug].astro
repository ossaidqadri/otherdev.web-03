---
import { getCollection, render } from "astro:content";
import Words from "@/components/Words.astro";
import { defaultLocale, isLocale, langOf } from "@/i18n/locales";
import Layout from "@/layouts/Layout.astro";
import { getSite } from "@/lib/site";
import { Separator } from "@/lib/components/ui/separator";

// One page per locale and slug. A locale without its own text shows the English entry under its own URL.
export async function getStaticPaths() {
  const entries = await getCollection("legal");
  const slugs = entries.filter((e) => e.id.startsWith(`${defaultLocale}/`)).map((e) => e.id.slice(defaultLocale.length + 1));
  const codes = (await getCollection("site")).map((e) => e.id).filter(isLocale);
  return codes.flatMap((locale) =>
    slugs.map((slug) => {
      const entry = entries.find((e) => e.id === `${locale}/${slug}`) ?? entries.find((e) => e.id === `${defaultLocale}/${slug}`);
      return { params: { locale: locale === defaultLocale ? undefined : locale, slug }, props: { entry } };
    }),
  );
}

const { entry } = Astro.props;
if (!entry) throw new Error("legal entry missing");
const { ui } = await getSite(Astro.currentLocale);
const { title, updated, description } = entry.data;
const { Content } = await render(entry);
const STEP = 75;
const lang = langOf(Astro.currentLocale);
// English keeps the reference's "October 21st, 2025"; other languages use their own long date.
const ordinal = { one: "st", two: "nd", few: "rd", other: "th" }[new Intl.PluralRules("en", { type: "ordinal" }).select(updated.getUTCDate()) as "one" | "two" | "few" | "other"];
const date =
  lang === "en"
    ? `${new Intl.DateTimeFormat("en", { month: "long", timeZone: "UTC" }).format(updated)} ${updated.getUTCDate()}${ordinal}, ${updated.getUTCFullYear()}`
    : new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" }).format(updated);
---

<Layout title={`${title} | Other Dev`} description={description ?? `${title} for otherdev.com`}>
  <main id="main">
    {/* "Legal" over the policy's title, fading up word by word like the services hero. */}
    <section class="pt-[var(--container-navpadding)]" data-navbar-theme="dark">
      <div class="site-container py-[var(--section-padding-lg)]">
        <div class="flex max-w-[64rem] flex-col" data-in>
          <Words as="h1" text={ui.legal ?? ""} step={STEP} class="gap-x-[0.45em] gap-y-[0.1em]" word="type-mega-button" />
          <Words text={title} step={STEP} start={(ui.legal ?? "").split(/\s+/).length} class="gap-x-[0.45em] gap-y-[0.1em] opacity-40" word="type-mega-button" />
        </div>
      </div>
    </section>

    <section data-navbar-theme="dark">
      <div class="site-container flex flex-col gap-[var(--section-padding-sm)] pt-[var(--section-padding-sm)] pb-[var(--section-padding-lg)]">
        <Separator />
        {/* The date in a 256px column, the policy in the reference's 640px article column beside it. */}
        <div class="flex flex-col gap-8 lg:grid lg:grid-cols-[16rem_40rem] lg:gap-x-28">
          <p class="type-body-regular-l self-start pt-1 leading-none opacity-60">
            {ui.lastUpdated}<br />
            <time datetime={updated.toISOString().slice(0, 10)}>{date}</time>
          </p>
          <div class="prose-site type-article-body article-prose"><Content /></div>
        </div>
        <Separator />
      </div>
    </section>
  </main>
</Layout>
