---
import { getCollection } from "astro:content";
import { getPage, getSite } from "@/lib/site";

interface Props {
  /** Show every project and drop the "See all" link (the /work page). */
  all?: boolean;
}

const { all = false } = Astro.props;
const { work } = await getPage("home");
const { ui } = await getSite();
const sorted = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
// Home shows the hand-picked projects in the order site.json lists them.
const projects = all
  ? sorted
  : work.featured.flatMap((id) => sorted.filter((p) => p.id === id));
const filters = ["Strategy", "Design", "Technology", "Experience"].filter((t) => projects.some((p) => p.data.tags.includes(t as never)));
---

<section id="work" class="section" data-navbar-theme="dark" data-section>
  <div class="site-container">
    <div class="flex items-end justify-between gap-6">
      <h2 class="type-heading-l max-w-4xl">{work.heading}</h2>
      {!all && (
        <a href={work.all.href} class="group relative -mr-2.5 inline-flex shrink-0 items-center rounded-lg px-2.5 py-1.5">
          <span class="type-heading-l relative z-10 inline-flex items-center gap-1 opacity-40">
            <span>{work.all.label}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 translate-y-[0.03em]" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
          <span aria-hidden="true" class="wash group-hover:opacity-100 group-focus-visible:opacity-100"></span>
        </a>
      )}
    </div>
    {all && (
      <div class="mt-12 flex flex-wrap items-center justify-between gap-6" data-work-controls>
        <div role="group" aria-label={ui.filterLabel} class="type-heading-s flex flex-wrap items-center gap-x-1">
          <button type="button" data-filter="all" aria-pressed="true" class="filter-pill">{ui.all}</button>
          <span class="bg-border mx-2 h-px w-6" aria-hidden="true"></span>
          {filters.map((t) => <button type="button" data-filter={t} aria-pressed="false" class="filter-pill">{t}</button>)}
        </div>
        <div role="group" aria-label={ui.viewLabel} class="flex items-center gap-1">
          <button type="button" data-set-view="grid" aria-pressed="false" aria-label={ui.gridView} class="view-btn">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" /><rect x="11" y="2" width="5" height="5" rx="1" /><rect x="2" y="11" width="5" height="5" rx="1" /><rect x="11" y="11" width="5" height="5" rx="1" /></svg>
          </button>
          <button type="button" data-set-view="list" aria-pressed="true" aria-label={ui.listView} class="view-btn">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14" /></svg>
          </button>
        </div>
      </div>
    )}
    <ul class:list={["work-list", all ? "mt-12" : "mt-24"]} data-view="list" data-work-list>
      {projects.map((p) => (
        <li class="border-border work-item border-t py-16" data-tags={p.data.tags.join(",")}>
          <a href={`/work/${p.id}`} class="group flex flex-col gap-6 md:grid md:h-[490px] md:grid-cols-3 md:gap-4">
            <div class="flex flex-col justify-between gap-8 md:pr-16">
              <div>
                <h3 class="type-heading-l">{p.data.title}</h3>
                {p.data.excerpt && <p class="type-heading-s text-ink-3 mt-3 line-clamp-3">{p.data.excerpt}</p>}
              </div>
              <span class="flex flex-wrap gap-1">
                {(p.data.tags.length ? p.data.tags : [String(p.data.year)]).map((t) => (
                  <span class="type-body-button-s inline-flex w-fit items-center rounded-sm px-2.5 py-1.5 transition duration-300 hover:brightness-[0.97]" style="background: var(--semantic-transparent-weak)">{t}</span>
                ))}
              </span>
            </div>
            <div class="relative aspect-[455/256] overflow-hidden rounded-lg md:col-span-2 md:aspect-auto">
              <img
                src={p.data.cover.src}
                alt={p.data.cover.alt}
                width={p.data.cover.width}
                height={p.data.cover.height}
                loading="lazy"
                class="size-full object-cover object-top"
              />
              {p.data.gallery[0] && (
                <img
                  src={p.data.gallery[0].src}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 size-full object-cover object-top opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                />
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .filter-pill {
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    opacity: 0.4;
    transition: opacity 0.2s ease-out, background-color 0.2s ease-out;
  }
  .filter-pill:hover {
    opacity: 0.7;
  }
  .filter-pill[aria-pressed="true"] {
    opacity: 1;
    background: var(--semantic-transparent-weak);
  }
  .view-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    opacity: 0.4;
  }
  .view-btn[aria-pressed="true"] {
    opacity: 1;
    background: var(--semantic-transparent-weak);
  }
  /* Grid view: two columns of cards, media first. */
  .work-list[data-view="grid"] {
    display: grid;
    gap: 3rem 0.5rem;
  }
  @media (min-width: 48rem) {
    .work-list[data-view="grid"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .work-list[data-view="grid"] .work-item {
    padding: 0;
    border: 0;
  }
  .work-list[data-view="grid"] .work-item > a {
    display: flex;
    flex-direction: column-reverse;
    height: auto;
    gap: 1rem;
  }
  .work-list[data-view="grid"] .work-item > a > div:last-child {
    aspect-ratio: 455 / 256;
  }
  .work-list[data-view="grid"] .work-item > a > div:first-child {
    padding-right: 0;
  }
  .work-list[data-view="grid"] .work-item p {
    display: none;
  }
</style>

<script>
  import "@/scripts/work-filter";
</script>
