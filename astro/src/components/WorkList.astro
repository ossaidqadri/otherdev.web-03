---
import { getCollection } from "astro:content";
import { Badge } from "@/lib/components/ui/badge";
import { Button } from "@/lib/components/ui/button";
import { Card } from "@/lib/components/ui/card";
import { getPage } from "@/lib/site";

// Home "Our work": the hand-picked projects, in the order home.json lists them.
const { work } = await getPage("home");
const sorted = await getCollection("projects");
const projects = work.featured.flatMap((id) => sorted.filter((p) => p.id === id));
// Hover fades to the first gallery shot that isn't the cover (the reference fades in a video;
// projects have none yet).
const hoverImage = (p: (typeof projects)[number]) => p.data.gallery.find((g) => g.src !== p.data.cover.src);
---

<section id="work" class="section" data-navbar-theme="dark" data-section>
  <div class="site-container">
    <div class="flex w-full flex-col items-start gap-2 md:flex-row md:items-end md:gap-8">
      <div class="flex-1"><h2 class="type-heading-l max-w-[64rem]">{work.heading}</h2></div>
      <Button href={work.all.href} variant="nav" size="nav" class="type-heading-l -ml-2.5 rounded-lg md:ml-0">
        <span class="inline-flex items-center gap-1 opacity-40">
          <span>{work.all.label}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 translate-y-[0.03em]" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </span>
      </Button>
    </div>
    {/* Phones, as on the reference: rule 72 under the heading, 48 of padding either side of a row, a rule after the last. */}
    <ul class="mt-18 md:mt-24">
      {projects.map((p) => (
        <li class="border-border border-t py-12 max-md:last:border-b md:py-16">
          <a href={`/work/${p.id}`} class="group flex w-full flex-col gap-6 transition-opacity duration-200 md:grid md:h-[490px] md:grid-cols-3 md:gap-4">
            <div class="flex flex-col justify-between gap-6 md:gap-8 md:pr-16">
              <div>
                <h3 class="type-heading-l">{p.data.title}</h3>
                {p.data.excerpt && <p class="type-heading-s mt-3 opacity-40">{p.data.excerpt}</p>}
              </div>
              <span class="flex flex-wrap gap-1">
                {(p.data.tags.length ? p.data.tags : [String(p.data.year)]).map((t) => (
                  <Badge variant="tag" class="type-body-button-s">{t}</Badge>
                ))}
              </span>
            </div>
            <Card variant="tile" class="block aspect-[455/256] md:col-span-2 md:aspect-auto">
              <img
                src={p.data.cover.src}
                alt={p.data.cover.alt}
                width={p.data.cover.width}
                height={p.data.cover.height}
                loading="lazy"
                class="size-full object-cover object-top"
              />
              {hoverImage(p) && (
                <img
                  src={hoverImage(p)?.src}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 size-full object-cover object-top opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                />
              )}
            </Card>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
