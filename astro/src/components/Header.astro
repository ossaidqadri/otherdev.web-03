---
import { Button } from "@/lib/components/ui/button";
import { Separator } from "@/lib/components/ui/separator";
import { toLocale } from "@/i18n/locales";
import { localize } from "@/i18n/url";
import { getSite } from "@/lib/site";

const locale = toLocale(Astro.currentLocale);
const site = await getSite(locale);
const home = localize("/", locale);
---

{/* Progressive blur at the top edge: content softens as it scrolls under the header. */}
<div class="header-blur pointer-events-none fixed inset-x-0 top-0 z-40 h-28 backdrop-blur-md [mask-image:linear-gradient(to_bottom,black_30%,transparent_100%)]" aria-hidden="true"></div>

<header class="header fixed inset-x-0 top-0 z-50 flex items-center justify-between px-[var(--container-padding)] py-6 md:py-8">
  <a href={home} class="wordmark" aria-label={`${site.name} home`}>{site.name}</a>
  <nav aria-label={site.ui.mainNav} class="type-body-button-m -me-2.5 flex items-center gap-2">
    {site.nav.map((l) => <Button href={l.href} variant="nav" size="nav" class="hidden md:inline-flex">{l.label}</Button>)}
    <Button href={site.cta.href} variant="nav" size="nav">{site.cta.label}</Button>
    {/* Three 1px bars, 20px wide, 5.5px apart, as on the reference. */}
    <Button popovertarget="menu" aria-label={site.ui.menuOpen} variant="nav" size="icon-nav" class="me-2.5 size-5 flex-col gap-[5.5px] md:hidden">
      {[0, 1, 2].map(() => <span class="h-px w-5 bg-current" aria-hidden="true"></span>)}
    </Button>
  </nav>
</header>

{/* Phone menu: a native popover with the Sheet's top-side classes, so open, close, Escape and focus return need no JS. */}
<div id="menu" popover data-slot="sheet-content" data-side="top" data-lenis-prevent class="menu type-heading-m fixed inset-x-0 top-0 z-50 m-0 h-dvh max-h-none w-full max-w-none flex-col border-0 p-0">
  {/* Same row as the header, so opening the menu only turns the bars into an X. */}
  <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-[var(--container-padding)] py-6">
    <a href={home} class="wordmark" aria-label={`${site.name} home`}>{site.name}</a>
    <div class="type-body-button-m -me-2.5 flex items-center gap-2">
      <Button href={site.cta.href} variant="nav" size="nav">{site.cta.label}</Button>
      <Button popovertarget="menu" popovertargetaction="hide" aria-label={site.ui.menuClose} variant="nav" size="icon-nav" class="me-2.5 size-5">
        <svg width="20" height="20" class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2.93 2.93l14.14 14.14M17.07 2.93L2.93 17.07" /></svg>
      </Button>
    </div>
  </div>
  {/* Centred on the whole screen: the pages, a short rule, then the call to action. */}
  <ul class="flex h-full flex-col items-center justify-center gap-5">
    {site.nav.map((l) => <li><Button href={l.href} variant="nav" size="nav" class="type-heading-l rounded-lg">{l.label}</Button></li>)}
    <li aria-hidden="true" class="my-1.5"><Separator decorative class="data-horizontal:w-[30px]" /></li>
    <li><Button href={site.cta.href} variant="nav" size="nav" class="type-heading-l rounded-lg">{site.cta.label}</Button></li>
  </ul>
</div>

<style>
  /* The motion layer flips data-nav-theme on <html> from the section under the header. */
  .header {
    color: var(--nav-fg, #fff);
    transition: color 0.2s var(--ease-out, ease-out), transform 0.4s cubic-bezier(0, 0, 0.2, 1);
  }
  /* Slides up on scroll down, back on any scroll up (measured on the reference: ~0.4s ease-out, hidden at 60px). */
  :global(html[data-nav-hidden]) .header {
    transform: translateY(-100%);
  }
  :global(html[data-nav-theme="dark"]) .header {
    --nav-fg: var(--global-neutral-900);
  }
  /* The Sheet's open/close (fade plus slide-in-from-top-10, 200ms ease-in-out) in CSS. */
  .menu {
    color: var(--global-neutral-900);
    background: linear-gradient(to bottom, var(--global-winter-300), var(--global-winter-100) 60%, #fff);
    opacity: 0;
    translate: 0 -2.5rem;
    transition: opacity 0.2s ease-in-out, translate 0.2s ease-in-out, display 0.2s allow-discrete, overlay 0.2s allow-discrete;
  }
  /* display only while open: a display utility on the element would override the UA's hidden state. */
  .menu:popover-open {
    display: flex;
    opacity: 1;
    translate: 0 0;
    @starting-style {
      opacity: 0;
      translate: 0 -2.5rem;
    }
  }
  /* Over the footer scene its own social nav takes the header's place. */
  :global(html[data-nav-theme="footer"]) .header-blur,
  :global(html[data-nav-theme="footer"]) .header {
    opacity: 0;
    pointer-events: none;
  }
</style>
