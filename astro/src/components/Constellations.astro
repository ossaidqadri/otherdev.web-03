---
import { getEntry } from "astro:content";

const { constellations: c } = (await getEntry("site", "home"))!.data;
---

<section class="constellations relative h-[200vh]" data-navbar-theme="light" data-scene="constellations">
  <div class="sticky top-0 flex h-screen flex-col justify-between pt-[20vh] pb-[var(--section-padding-sm)]">
    <div class="site-container relative z-10 w-full">
      <h2 class="type-display-s text-white">{c.heading}</h2>
      <p class="type-display-s mt-2 max-w-[62rem] text-white/50">{c.body}</p>
    </div>
    <video
      class="scrub-video absolute top-0 left-1/2 h-full -translate-x-1/2 object-cover"
      src="https://media.otherdev.com/site/video/approach-scrub.mp4"
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
      data-scrub
    ></video>
    <div class="site-container relative z-10 w-full">
      <a href={c.button.href} class="pill type-body-button-m">{c.button.label}</a>
    </div>
  </div>
</section>

<style>
  .constellations {
    background: linear-gradient(to bottom, var(--global-summer-100) 0%, #ee9a5c 32%, #8f3a28 72%, #3b1d14 100%);
  }
  .scrub-video {
    pointer-events: none;
    opacity: 0;
  }
  .pill {
    display: inline-block;
    padding: 1rem 1.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }
</style>
