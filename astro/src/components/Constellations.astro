---
import CtaScene from "@/components/CtaScene.astro";
import { getPage } from "@/lib/site";

const { constellations: c } = await getPage("home");
---

{/* Home's closing scene: cream through orange to brown. */}
<CtaScene
  heading={c.heading}
  body={c.body}
  button={c.button}
  sky="linear-gradient(to bottom, #fff 0%, var(--global-summer-500) 45%, var(--global-summer-700) 75%, var(--global-autumn-900) 100%)"
/>
