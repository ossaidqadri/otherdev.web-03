---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Card } from "@/lib/components/ui/card";
import { getPage } from "@/lib/site";

const { process } = await getPage("home");
// Card art lives in src/assets/process; the site collection names each file.
const art = import.meta.glob<ImageMetadata>("@/assets/process/*", { eager: true, import: "default" });
const imageFor = (file: string) => art[`/src/assets/process/${file}`];
---

<section id="process" class="section overflow-hidden" data-navbar-theme="dark" data-section>
  <div class="site-container">
    <h2 class="type-heading-l max-w-4xl">{process.heading}</h2>
  </div>
  {/* An Embla carousel like the reference's: the viewport is the container width, the track overflows
       to the page edge (the section clips it), cards are 1/3 wide on desktop, 1/2 on sm, full on phones. */}
  <div class="site-container mt-[calc(4rem*var(--scale))]">
    <div data-process-viewport>
    <ul class="group/offerings -ml-4 flex touch-pan-y" data-process-track>
      {process.steps.map((s) => {
        const img = imageFor(s.image);
        return (
          <li class="min-w-0 shrink-0 grow-0 basis-full pl-4 sm:basis-1/2 lg:basis-1/3">
            <Card
              variant="tile"
              class="aspect-[427/591] cursor-grab justify-between bg-[var(--semantic-transparent-weak)] transition-[background-color,opacity,scale] duration-300 ease-out select-none group-hover/offerings:opacity-40 hover:bg-(--hover-bg) hover:opacity-100! group-active/offerings:scale-95 active:cursor-grabbing"
              style={`--hover-bg: var(--semantic-${s.tone}-weak-dark)`}
            >
              {/* Plain h3/p: shadcn's CardTitle renders a div and would drop the heading. */}
              <div class="p-8">
                <h3 class="type-heading-m transition-colors duration-300 group-hover/card:text-[var(--semantic-text-primary-dark)]">{s.title}</h3>
                <p class="type-heading-s mt-[3px] opacity-40 transition-colors duration-300 group-hover/card:text-[var(--semantic-text-primary-dark)]">{s.body}</p>
              </div>
              {img && <Image src={img} alt="" widths={[400, 800]} sizes="26.5rem" draggable="false" class="pointer-events-none mx-auto w-full" />}
            </Card>
          </li>
        );
      })}
    </ul>
    </div>
  </div>
</section>

<script>
  import "@/scripts/drag";
</script>

<style>
  /* The carousel viewport clips by default; the reference lets the track run to the page edge. */
  [data-process-viewport] {
    overflow: visible;
  }
</style>
