---
import { getEntry } from "astro:content";

const { pill } = (await getEntry("site", "home"))!.data;
---

<nav aria-label="Sections" class="pill-nav type-body-button-s fixed bottom-6 left-1/2 z-50 -translate-x-1/2" data-pill>
  <ul class="flex gap-1 rounded-full p-1.5">
    {pill.map((p) => (
      <li><a href={`#${p.target}`} class="block rounded-full px-3.5 py-2.5">{p.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  /* Dark pill over light sections, light pill over dark ones; the motion layer sets data-pill-theme. */
  .pill-nav ul {
    background: var(--global-neutral-900);
    transition: background 0.2s var(--ease-out, ease-out);
  }
  .pill-nav a {
    color: rgb(255 255 255 / 0.45);
    transition: color 0.2s var(--ease-out, ease-out);
  }
  .pill-nav a[aria-current] {
    color: #fff;
  }
  :global(html[data-pill-theme="light"]) .pill-nav ul {
    background: var(--global-neutral-100);
  }
  :global(html[data-pill-theme="light"]) .pill-nav a {
    color: rgb(0 0 0 / 0.4);
  }
  :global(html[data-pill-theme="light"]) .pill-nav a[aria-current] {
    color: #000;
  }
</style>
