---
import { Button } from "@/lib/components/ui/button";
import { getSite } from "@/lib/site";

interface Props {
  /** Sections to list, as { label, target id }; defaults to the home page's. */
  items?: { label?: string; target: string }[];
}

const { pill, ui } = await getSite(Astro.currentLocale);
const { items = pill } = Astro.props;
---

{/* Desktop only, as on the reference: phones get no floating section nav. */}
<nav aria-label={ui.sectionsNav} class="pill-nav type-body-button-s fixed bottom-6 left-1/2 z-50 hidden -translate-x-1/2 md:block" data-pill>
  <ul class="flex items-center rounded-full p-2 backdrop-blur-md">
    {items.map((p) => (
      <li><Button href={`#${p.target}`} variant="spy" size="spy" class="flex">{p.label}</Button></li>
    ))}
  </ul>
</nav>

<style>
  .pill-nav {
    transition: opacity 0.3s cubic-bezier(0, 0, 0.2, 1), translate 0.3s cubic-bezier(0, 0, 0.2, 1);
  }
  /* Hidden near the top of the page (motion.ts) and over the footer scene, as on the reference. */
  :global(html[data-pill-hidden]) .pill-nav,
  :global(html[data-nav-theme="footer"]) .pill-nav {
    opacity: 0;
    translate: -50% 8px;
    pointer-events: none;
  }
  /* Black pill over light sections, light pill over dark ones; the motion layer sets data-pill-theme.
     --fg colours the items (Button variant "spy"). */
  .pill-nav ul {
    --fg: #fff;
    background: rgb(0 0 0 / 0.92);
    box-shadow: 0 1px 24px rgb(40 50 80 / 0.12);
    transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(html[data-pill-theme="light"]) .pill-nav ul,
  :global(html[data-pill-theme="footer"]) .pill-nav ul {
    --fg: #000;
    background: rgb(244 243 242 / 0.92);
  }
</style>
