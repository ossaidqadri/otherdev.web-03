---
import { getPage } from "@/lib/site";

const { hero } = await getPage("home");
const words = hero.statement.split(" ");
---

<section class="hero relative h-[240vh]" data-navbar-theme="light" data-scene="hero" data-flip="light:dark:0.45">
  <div class="stage sticky top-0 flex h-svh flex-col justify-between pt-[28.4vh] pb-28 md:pb-[var(--section-padding-lg)]">
    {/* Two layers share one spot: the motion layer sets --p (0 to 1, scroll through the
         scene) and the headline gives way to the word-by-word statement. */}
    <div class="site-container grid w-full">
      <h1 class="layer layer-headline type-hero max-w-5xl text-white">{hero.headline}</h1>
      <p class="layer layer-statement type-hero max-w-[64rem]" data-reveal-words>
        {words.map((w, i) => (
          <>
            <span class="word" data-word>{w}</span>{i < words.length - 1 ? " " : ""}
          </>
        ))}
      </p>
    </div>
    <div class="site-container w-full">
      <a href={hero.button.href} class="pill type-body-button-m">{hero.button.label}</a>
    </div>
  </div>
</section>

<style>
  /* Sky runs the whole scene: brown, navy, pale blue, cream. */
  .hero {
    --p: 0;
    background: linear-gradient(
      to bottom,
      rgb(40 14 1) 0%,
      rgb(24 38 68) 12%,
      rgb(90 118 159) 32%,
      rgb(135 161 196) 52%,
      rgb(193 211 230) 68%,
      rgb(254 249 225) 84%,
      rgb(247 243 240) 100%
    );
  }
  .layer {
    grid-area: 1 / 1;
  }
  .layer-headline {
    opacity: clamp(0, calc(1 - (var(--p) - 0.12) * 10), 1);
  }
  .layer-statement {
    opacity: clamp(0, calc((var(--p) - 0.2) * 10), 1);
    pointer-events: none;
  }
  .word {
    color: var(--global-neutral-900);
    opacity: 0.35;
    transition: opacity 0.3s var(--ease-out, ease-out);
  }
  .word[data-on] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      grid-area: auto;
      opacity: 1;
    }
    .layer-statement {
      margin-top: 4rem;
      color: #fff;
    }
    .word {
      color: inherit;
      opacity: 1;
    }
  }
  .pill {
    display: inline-block;
    padding: 1rem 1.5rem;
    border-radius: 9999px;
    /* White on the dark sky, dark once the sky has turned pale. */
    --to-dark: clamp(0, calc((var(--p) - 0.3) * 5), 1);
    background: color-mix(in oklab, rgb(255 255 255 / 0.16) calc((1 - var(--to-dark)) * 100%), rgb(0 0 0 / 0.06));
    color: color-mix(in oklab, #fff calc((1 - var(--to-dark)) * 100%), var(--global-neutral-900));
  }
</style>
