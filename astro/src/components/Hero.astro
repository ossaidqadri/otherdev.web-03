---
import Words from "@/components/Words.astro";
import { Button } from "@/lib/components/ui/button";
import { getPage } from "@/lib/site";

const { hero } = await getPage("home");
const words = hero.statement.split(" ");
---

<section class="hero relative h-[240vh]" data-navbar-theme="light" data-scene="hero" data-flip="light:dark:0.45">
  <div class="stage sticky top-0 flex h-svh flex-col justify-between pt-[calc(var(--container-navpadding)+var(--section-padding-lg))] pb-[var(--section-padding-lg)]">
    {/* Two layers share one spot: the motion layer sets --p (0 to 1, scroll through the
         scene) and the headline gives way to the word-by-word statement. */}
    <div class="site-container grid w-full">
      <Words as="h1" text={hero.headline} data-in class="layer layer-headline content-start gap-x-[calc(0.625rem*var(--scale,1))] gap-y-[calc(0.25rem*var(--scale,1))] max-w-[64rem] text-white" word="type-hero" />
      {/* Same word gaps; these words fill in with scroll progress instead of the entrance. */}
      <p class="layer layer-statement flex max-w-[64rem] flex-wrap content-start items-center gap-x-[calc(0.625rem*var(--scale,1))] gap-y-[calc(0.25rem*var(--scale,1))]" data-reveal-words>
        {words.map((w) => <span class="word type-hero" data-word>{w}</span>)}
      </p>
    </div>
    <div class="pill-colors site-container w-full">
      <Button href={hero.button.href} variant="glass" size="pill" reveal class="type-body-button-m">{hero.button.label}</Button>
    </div>
  </div>
</section>

<style>
  /* Sky runs the whole scene: brown, navy, pale blue, cream. */
  .hero {
    --p: 0;
    background: linear-gradient(
      to bottom,
      rgb(40 14 1) 0%,
      rgb(24 38 68) 12%,
      rgb(90 118 159) 32%,
      rgb(135 161 196) 52%,
      rgb(193 211 230) 68%,
      rgb(254 249 225) 84%,
      rgb(247 243 240) 100%
    );
  }
  .layer {
    grid-area: 1 / 1;
  }
  .layer-headline {
    opacity: clamp(0, calc(1 - (var(--p) - 0.12) * 10), 1);
  }
  .layer-statement {
    opacity: clamp(0, calc((var(--p) - 0.2) * 10), 1);
    pointer-events: none;
  }
  .word {
    color: var(--global-neutral-900);
    opacity: 0.35;
    transition: opacity 0.3s var(--ease-out, ease-out);
  }
  .word[data-on] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      grid-area: auto;
      opacity: 1;
    }
    .layer-statement {
      margin-top: 4rem;
      color: #fff;
    }
    .word {
      color: inherit;
      opacity: 1;
    }
  }
  /* The pill (Button "glass") is white on the dark sky and turns dark once the sky has gone pale. */
  .pill-colors {
    --to-dark: clamp(0, calc((var(--p) - 0.3) * 5), 1);
    --pill-bg: color-mix(in oklab, rgb(255 255 255 / 0.16) calc((1 - var(--to-dark)) * 100%), rgb(0 0 0 / 0.06));
    --pill-fg: color-mix(in oklab, #fff calc((1 - var(--to-dark)) * 100%), var(--global-neutral-900));
    /* Hover as on the reference: brighter white on the dark sky, the dark fill once it is pale. */
    --pill-bg-hover: color-mix(in oklab, #ffffff52 calc((1 - var(--to-dark)) * 100%), var(--semantic-neutral-core));
  }
</style>
