---
import { getCollection } from "astro:content";
import { langOf } from "@/i18n/locales";
import { getPage } from "@/lib/site";
import NewsletterCard from "@/components/NewsletterCard.astro";
import PostCard from "@/components/PostCard.astro";
import TeamCard from "@/components/TeamCard.astro";
import { Button } from "@/lib/components/ui/button";
import { Separator } from "@/lib/components/ui/separator";

const { news } = await getPage("home", Astro.currentLocale);
const about = await getPage("about", Astro.currentLocale);
const date = new Intl.DateTimeFormat(langOf(Astro.currentLocale), { dateStyle: "medium" });

// The newest blog posts, three at most.
const cards = (await getCollection("blog"))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)
  .slice(0, 3)
  .map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, excerpt: p.data.excerpt, label: date.format(p.data.publishedAt) }));
---

<section id="news" class="section" data-navbar-theme="dark" data-section>
  <div class="site-container">
    <div class="flex w-full flex-col items-start gap-2 md:flex-row md:items-end md:gap-8">
      <div class="flex-1"><h2 class="type-heading-l max-w-[64rem]">{news.heading}</h2></div>
      <Button href={news.all.href} variant="nav" size="nav" class="type-heading-l -ml-2.5 shrink-0 rounded-lg md:ml-0">
        <span class="inline-flex items-center gap-1 opacity-60">
          <span>{news.all.label}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 translate-y-[0.03em]" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </span>
      </Button>
    </div>

    <Separator decorative class="mt-24" />

    <ul class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => <li><PostCard {...c} /></li>)}
      {about.team.map((m) => (
        <li><TeamCard {...m} overlay /></li>
      ))}
    </ul>

    <Separator decorative class="mt-16" />

    <NewsletterCard class="mt-16" />
  </div>
</section>
