---
import { getCollection } from "astro:content";
import { getPage, getSite } from "@/lib/site";
import TeamCard from "@/components/TeamCard.astro";
import { Button } from "@/lib/components/ui/button";
import { Card } from "@/lib/components/ui/card";
import { Input } from "@/lib/components/ui/input";

const { news } = await getPage("home");
const about = await getPage("about");
const newsletter = await getPage("newsletter");
const { ui } = await getSite();
const date = new Intl.DateTimeFormat("en", { dateStyle: "medium" });

// The newest blog posts, three at most. Posts have no cover art yet, so a gradient stands in.
const cards = (await getCollection("blog"))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)
  .slice(0, 3)
  .map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, label: date.format(p.data.publishedAt) }));
---

<section id="news" class="section" data-navbar-theme="dark" data-section>
  <div class="site-container">
    <div class="flex items-end justify-between gap-6">
      <h2 class="type-heading-l max-w-4xl">{news.heading}</h2>
      <a href={news.all.href} class="type-heading-l text-ink-3 shrink-0">{news.all.label} →</a>
    </div>

    <ul class="border-border mt-[calc(4rem*var(--scale))] grid gap-x-2 gap-y-12 border-t pt-16 md:grid-cols-3">
      {cards.map((c) => (
        <li>
          <a href={c.href} class="group block">
            <Card variant="tile" class="aspect-[4/5] w-full bg-[linear-gradient(160deg,var(--global-winter-300-dark),var(--global-autumn-50-dark))]" />
            <p class="type-body-regular-s text-ink-3 mt-4">{c.label}</p>
            <h3 class="type-body-regular-l mt-1 max-w-sm">{c.title}</h3>
          </a>
        </li>
      ))}

      {about.team.map((m) => (
        <li><TeamCard {...m} overlay /></li>
      ))}

      <li>
        <Card variant="tile" class="aspect-[4/5] justify-between bg-[linear-gradient(135deg,var(--global-neutral-100)_0%,var(--global-summer-300)_45%,var(--global-summer-500)_100%)] p-8 text-[color:var(--global-neutral-900)]">
          <div>
            <h3 class="type-heading-m">{newsletter.heading}</h3>
            <p class="type-body-paragraph-l mt-2 opacity-60">{newsletter.body}</p>
          </div>
          {/* Disabled until a signup backend is chosen. */}
          <form>
            <fieldset disabled class="flex flex-col gap-2 [--pill-bg:rgb(255_255_255/0.8)] [--pill-fg:currentColor]">
              <Input variant="soft" type="email" placeholder={ui.emailPlaceholder} aria-label={newsletter.fields.email} class="type-body-regular-m bg-white/70" />
              <Button type="submit" variant="glass" size="pill-sm" class="type-body-button-m w-fit disabled:opacity-60">{ui.signUp}</Button>
            </fieldset>
            <p class="type-body-regular-xs mt-3 opacity-60">{newsletter.note}</p>
          </form>
        </Card>
      </li>
    </ul>
  </div>
</section>

