---
import { getEntry } from "astro:content";

const { footer: f, name } = (await getEntry("site", "home"))!.data;
const poster = "https://media.otherdev.com/site/video/footer-flower-poster.webp";
// "10:42pm", the reference's clock format.
const clock = (tz: string) =>
  new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone: tz })
    .format(new Date())
    .replace(/\s/g, "")
    .toLowerCase();
---

<!-- One sky runs the whole footer: dark brown through burnt orange to amber. -->
<footer class="footer text-white">
  <section class="min-h-[513px]" data-navbar-theme="footer" data-section>
    <div class="site-container section" style="padding-block: var(--section-padding-md)">
      <a href={f.cta.href} class="type-heading-l">{f.cta.label} →</a>
      <ul class="mt-16 grid grid-cols-2 md:grid-cols-4">
        {f.offices.map((o) => (
          <li>
            <h3 class="type-heading-m">{o.city}</h3>
            <p class="type-heading-m text-white/50" data-clock={o.timezone}>{clock(o.timezone)}</p>
            <p class="type-body-button-xs mt-8 text-white/50">
              <a href={`mailto:${o.email}`} class="block">{o.email}</a>
              <a href={`tel:${o.phone.replace(/\s/g, "")}`} class="block">{o.phone}</a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative h-[250vh]" data-navbar-theme="footer" data-scene="footer">
    <div class="sticky top-0 h-svh overflow-hidden">
      <video
        class="absolute bottom-0 left-1/2 aspect-square h-[90vh] max-w-none -translate-x-1/2 object-contain md:h-screen"
        poster={poster}
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        data-scrub
      >
        <source src="https://media.otherdev.com/site/video/footer-flower-mobile.webm" type="video/webm" media="(max-width: 767px)" />
        <source src="https://media.otherdev.com/site/video/footer-flower.webm" type="video/webm" />
      </video>
      <nav aria-label="Social" class="type-body-button-s absolute inset-x-0 top-0 z-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-[var(--container-padding)] py-7">
        <span class="wordmark">{name}</span>
        <ul class="flex gap-3 md:gap-7">
          {f.social.map((s) => <li><a href={s.href} rel="noopener noreferrer" target="_blank">{s.label}</a></li>)}
        </ul>
      </nav>
      <p class="type-body-button-s absolute bottom-28 left-[calc(var(--container-padding)+10px)] z-10 md:bottom-10">{f.legal} {new Date().getFullYear()}</p>
      <ul class="type-body-button-s absolute right-[calc(var(--container-padding)+10px)] bottom-28 z-10 flex gap-6 md:bottom-10">
        {f.legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</footer>

<style>
  .footer {
    background: linear-gradient(to bottom, var(--global-autumn-900) 25%, var(--global-summer-700) 65%, var(--global-summer-600) 85%, var(--global-summer-500) 100%);
  }
</style>

<script>
  // Live office times; re-runs on every ClientRouter navigation.
  const tick = () => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-clock]")) {
      el.textContent = new Intl.DateTimeFormat("en", {
        hour: "numeric",
        minute: "2-digit",
        timeZone: el.dataset.clock ?? "UTC",
      })
        .format(new Date())
        .replace(/\s/g, "")
        .toLowerCase();
    }
  };
  document.addEventListener("astro:page-load", () => {
    tick();
    const id = setInterval(tick, 30_000);
    document.addEventListener("astro:before-swap", () => clearInterval(id), { once: true });
  });
</script>
