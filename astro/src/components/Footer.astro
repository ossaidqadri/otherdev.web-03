---
import CopyButton from "@/components/CopyButton.astro";
import { Button } from "@/lib/components/ui/button";
import { getSite } from "@/lib/site";

const { footer: f, name, ui } = await getSite(Astro.currentLocale);
const poster = "https://media.otherdev.com/site/video/footer-flower-poster.webp";
// The page is static, so a time rendered here would be the build's. The clocks start empty and the
// script below fills them (and refreshes the year, which is only right as of the last deploy).
const year = String(new Date().getFullYear());
---

{/* One sky runs the whole footer: dark brown through burnt orange to amber. */}
<footer class="footer text-white">
  <section class="min-h-[513px]" data-navbar-theme="light" data-section>
    <div class="site-container section" style="padding-block: var(--section-padding-md)">
      <a href={f.cta.href} class="group type-heading-l inline-flex items-center gap-1">
        {f.cta.label}
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[0.8em] transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
      <ul class="mt-[calc(4rem*var(--scale))] grid grid-cols-2 md:grid-cols-4">
        {f.offices.map((o) => (
          <li>
            <h3 class="type-heading-m">{o.city}</h3>
            <time class="type-heading-m block min-h-[1lh] text-white/50" data-clock={o.timezone}></time>
            {/* Click copies, as on the reference; a copy icon fades in to the left on hover. */}
            <div class="type-body-button-m mt-8 flex flex-col items-start gap-1">
              {[o.email, o.phone].map((v) => <CopyButton value={v} dim />)}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative h-[250vh]" data-navbar-theme="footer" data-scene="footer">
    <div class="sticky top-0 h-svh overflow-hidden">
      <video
        class="absolute bottom-0 left-1/2 aspect-square h-[90vh] max-w-none -translate-x-1/2 object-contain md:h-screen"
        data-poster={poster}
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        data-scrub
        data-scrub-rise
      >
        {/* Keyframe every 8 frames: scrubbing seeks constantly, and with one keyframe each seek decoded from frame 0. */}
        <source src="https://media.otherdev.com/site/video/footer-flower-mobile-scrub.webm" type="video/webm" media="(max-width: 767px)" />
        <source src="https://media.otherdev.com/site/video/footer-flower.webm" type="video/webm" />
      </video>
      <nav aria-label={ui.socialNav} class="type-body-button-s absolute inset-x-0 top-0 z-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-[var(--container-padding)] py-8">
        {/* The mark stands in for the wordmark, as New Genre's flower does; same path as favicon.svg. */}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" role="img" aria-label={name} class="size-8 shrink-0 fill-current"><path fill-rule="evenodd" d="M34 4a30 30 0 1 0 0 60 30 30 0 0 0 0-60Zm0 16a14 14 0 1 1 0 28 14 14 0 0 1 0-28ZM64 64h30a30 30 0 0 1 0 60H64Zm16 16v28h14a14 14 0 0 0 0-28Z" /></svg>
        {/* Chips as on the reference: a 29px tap target with the nav wash on hover; -mr keeps the text on the margin. */}
        <ul class="-mr-2.5 flex gap-2">
          {f.social.map((s) => (
            <li>
              <Button href={s.href} rel="noopener noreferrer" target="_blank" variant="nav" size="nav">
                {s.label}<span class="sr-only">{ui.opensInNewTab}</span>
              </Button>
            </li>
          ))}
        </ul>
      </nav>
      <p class="type-body-button-s absolute bottom-28 left-[calc(var(--container-padding)+10px)] z-10 md:bottom-10">{f.legal} <time datetime={year} data-year>{year}</time></p>
      <ul class="type-body-button-s absolute right-[var(--container-padding)] bottom-[calc(7rem-6px)] z-10 flex gap-2 md:bottom-[calc(2.5rem-6px)]">
        {f.legalLinks.map((l) => <li><Button href={l.href} variant="nav" size="nav">{l.label}</Button></li>)}
      </ul>
    </div>
  </section>
  <p role="status" data-toast data-copied={ui.copied} data-copy-failed={ui.copyFailed} class="type-body-regular-xs pointer-events-none fixed bottom-6 left-1/2 z-[60] w-[356px] max-w-[calc(100vw-2rem)] -translate-x-1/2 translate-y-2 rounded-[16px] bg-[var(--global-neutral-50)] p-4 text-[13px] font-medium text-[var(--global-neutral-900)] opacity-0 shadow-[0_4px_12px_rgb(0_0_0/0.1)] transition-[opacity,translate] duration-300"></p>
</footer>

<style>
  .footer {
    background: linear-gradient(to bottom, var(--global-autumn-900) 25%, var(--global-summer-700) 65%, var(--global-summer-600) 85%, var(--global-summer-500) 100%);
  }
</style>

<script>
  // Office clocks ("10:42pm", the reference's format, with a 24h `datetime` for the <time> element) and
  // the copyright year. One formatter pair per timezone; the timer lands on each minute change and
  // sleeps while the tab is hidden.
  const formats = new Map<string, [Intl.DateTimeFormat, Intl.DateTimeFormat]>();
  const formatsFor = (timeZone: string) => {
    let pair = formats.get(timeZone);
    if (!pair) {
      pair = [
        new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone }),
        new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone }),
      ];
      formats.set(timeZone, pair);
    }
    return pair;
  };
  const render = () => {
    const now = new Date();
    for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-clock]")) {
      const [shown, machine] = formatsFor(el.dataset.clock ?? "UTC");
      el.textContent = shown.format(now).replace(/\s/g, "").toLowerCase();
      el.dateTime = machine.format(now);
    }
    for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-year]")) {
      el.textContent = el.dateTime = String(now.getFullYear());
    }
  };
  let timer = 0;
  const stop = () => clearTimeout(timer);
  const run = () => {
    stop();
    render();
    timer = window.setTimeout(run, 60_000 - (Date.now() % 60_000));
  };
  // Office email and phone copy on click, confirmed by a toast in the reference's Sonner style.
  let hideToast = 0;
  const toast = (text: string) => {
    const el = document.querySelector<HTMLElement>("[data-toast]");
    if (!el) return;
    el.textContent = text;
    el.classList.remove("opacity-0", "translate-y-2");
    clearTimeout(hideToast);
    hideToast = window.setTimeout(() => el.classList.add("opacity-0", "translate-y-2"), 4000);
  };
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest<HTMLElement>("[data-copy]");
    if (!btn?.dataset.copy) return;
    const { copied = "", copyFailed = "" } = document.querySelector<HTMLElement>("[data-toast]")?.dataset ?? {};
    try {
      await navigator.clipboard.writeText(btn.dataset.copy);
      toast(copied);
    } catch {
      toast(copyFailed);
    }
  });
  run();
  document.addEventListener("visibilitychange", () => (document.hidden ? stop() : run()));
</script>
