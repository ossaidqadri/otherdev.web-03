---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, jsonLd } = Astro.props;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "otherdev",
  url: Astro.site,
  sameAs: ["https://linkedin.com/company/theotherdev/", "https://instagram.com/other.dev"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      jsonLd={jsonLd ?? (Astro.url.pathname === "/" ? organization : undefined)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-saans" preload={[{ weight: "450", style: "normal" }]} />
    <Font cssVariable="--font-serrif" preload />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>import "@/scripts/motion";</script>
  </body>
</html>
