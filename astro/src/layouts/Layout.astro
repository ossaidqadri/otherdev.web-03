---
import { Font } from "astro:assets";
import CursorLabel from "@/components/CursorLabel.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";
import { getSite } from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  published?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, imageAlt, type, published, noindex, jsonLd } = Astro.props;
const site = await getSite();
// Home only; profile links come from the footer's social list (WhatsApp is a chat link, not a profile).
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: Astro.site,
  logo: new URL("/android-chrome-512x512.png", Astro.site).href,
  description: site.description,
  address: { "@type": "PostalAddress", addressLocality: site.footer.offices[0]?.city, addressCountry: "PK" },
  sameAs: site.footer.social.filter((s) => !s.href.includes("wa.me")).map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      published={published}
      noindex={noindex}
      jsonLd={jsonLd ?? (Astro.url.pathname === "/" ? organization : undefined)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e1310" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-saans" preload={[{ weight: "450", style: "normal" }]} />
    <Font cssVariable="--font-serrif" preload />
    {/* Back and Forward slide the other way (global.css, :active-view-transition-type(back)). Has to be a classic
        script in the head: pagereveal fires before the first render, which is too early for the module scripts. */}
    <script is:inline>
      addEventListener("pagereveal", (e) => {
        const a = self.navigation?.activation;
        if (e.viewTransition && a?.navigationType === "traverse" && a.entry.index < a.from.index) e.viewTransition.types.add("back");
      });
    </script>
  </head>
  <body>
    {/* First tab stop: jumps past the header; visible only while focused. Targets <main id="main"> on each page. */}
    <a href="#main" class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[60] focus-visible:rounded-full focus-visible:bg-card focus-visible:px-6 focus-visible:py-4 focus-visible:ring-2 focus-visible:ring-[var(--semantic-transparent-strong)]">{site.ui.skipToContent}</a>
    <Header />
    <slot />
    <Footer />
<CursorLabel />
    {/* The scene scripts load after the page does (motion.ts), so start the header and pill in their top-of-page state now: nothing flashes.
        No scroll read here: it forces layout while the page is still parsing. A reload part-way down is corrected when the scripts arrive. */}
    <script is:inline>
      {
        const r = document.documentElement;
        r.dataset.navTheme = document.querySelector("[data-navbar-theme]")?.dataset.navbarTheme ?? "light";
        r.setAttribute("data-pill-hidden", "");
      }
    </script>
    <script>import "@/scripts/motion";</script>
  </body>
</html>
