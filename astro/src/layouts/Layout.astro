---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import CursorLabel from "@/components/CursorLabel.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";
import { getSite } from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  published?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, published, noindex, jsonLd } = Astro.props;
const site = await getSite();
// Home only; profile links come from the footer's social list (WhatsApp is a chat link, not a profile).
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: Astro.site,
  logo: new URL("/android-chrome-512x512.png", Astro.site).href,
  description: site.description,
  address: { "@type": "PostalAddress", addressLocality: site.footer.offices[0]?.city, addressCountry: "PK" },
  sameAs: site.footer.social.filter((s) => !s.href.includes("wa.me")).map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      published={published}
      noindex={noindex}
      jsonLd={jsonLd ?? (Astro.url.pathname === "/" ? organization : undefined)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-saans" preload={[{ weight: "450", style: "normal" }]} />
    <Font cssVariable="--font-serrif" preload />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
<CursorLabel />
    <script>import "@/scripts/motion";</script>
  </body>
</html>
